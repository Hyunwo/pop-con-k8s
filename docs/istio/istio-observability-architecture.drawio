        <!-- ============================================================ -->
        <mxCell id="kiali-box" value="&lt;b&gt;Kiali 통합 관측 (Single Pane of Glass)&lt;/b&gt;&lt;br&gt;─────────────────────────────&lt;br&gt;① Prometheus → 서비스별 RPS, 에러율, 레이턴시&lt;br&gt;② Jaeger → 요청 흐름 추적 (auth→queue→worker)&lt;br&gt;③ Grafana → 상세 대시보드 연결&lt;br&gt;─────────────────────────────&lt;br&gt;→ 서비스 토폴로지 그래프로 한눈에 파악" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;fontSize=10;fontStyle=0;align=left;spacingLeft=10;" vertex="1" parent="ns-istio">
